# Copy to .env (scripts/setup.sh does this for you and fills in random passwords).
# Use letters and digits only for the passwords.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Your time zone, so "today" and the nightly backup use local time.
# e.g. America/Vancouver, America/Edmonton, America/Winnipeg, America/Toronto, America/Halifax
TZ=America/Toronto

# Port the web app listens on in your home network: http://<box-ip>:8000
APP_PORT=8000

# Budget year start month (10 = October–September)
FY_START_MONTH=10

# Where nightly database dumps go. Point this at a USB drive or NAS mount for safety,
# e.g. /mnt/backup-usb/budget
BACKUP_PATH=./backups
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=30
